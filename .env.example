# Bu dosyayi .env olarak kopyalayip degerleri doldurun. .env dosyasi Git'e eklenmez.

# MySQL baglantisi. Mumkunse root yerine yalnizca bu veritabanina yetkili bir kullanici kullanin.
DATABASE_URL=mysql+pymysql://tarim_app:DEGISTIR@localhost:3306/tarim_karar_analiz

# JWT imzalama anahtari (en az 32 karakter). Uretmek icin:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=DEGISTIR
# Oturum suresi (dakika)
JWT_EXPIRE_MINUTES=480

# Docker Compose: rastgele URL-guvenli parolalar kullanin (ornegin secrets.token_urlsafe).
MYSQL_DATABASE=tarim_karar_analiz
MYSQL_USER=tarim_app
MYSQL_PASSWORD=DEGISTIR
MYSQL_ROOT_PASSWORD=DEGISTIR
FRONTEND_PORT=8080

# Virgulle ayrilmis izinli arayuz adresleri (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
